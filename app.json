{
  "expo": {
    "name": "MealFlow",
    "slug": "mealflow",
    "version": "2.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "at.mealflow.app",
      "buildNumber": "24"
    },
    "android": {
      "package": "at.mealflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#214F33"
      },
      "versionCode": 24,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "MealFlow benötigt die Kamera für unterstützte Barcode-Funktionen.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MealFlow benötigt das Mikrofon, damit du Produkte per Sprache zur Einkaufsliste hinzufügen kannst.",
          "speechRecognitionPermission": "MealFlow nutzt die Spracherkennung, um gesprochene Produkte in Text umzuwandeln.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "androidStatusBar": {
      "translucent": false
    }
  }
}
